<!-- demos/lueur/images/avatar.svg -->
<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200">
    <!-- Avatar d'exemple : remplace-le par ta propre photo -->
    <defs>
        <linearGradient id="fond" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#ff9ccc"/>
            <stop offset="55%" stop-color="#b294ff"/>
            <stop offset="100%" stop-color="#8fd3ff"/>
        </linearGradient>
        <mask id="croissant">
            <rect width="200" height="200" fill="#fff"/>
            <circle cx="122" cy="78" r="50" fill="#000"/>
        </mask>
    </defs>
    <rect width="200" height="200" fill="url(#fond)"/>
    <circle cx="94" cy="104" r="56" fill="#fffaf2" mask="url(#croissant)"/>
    <path d="M148 120 l6 15 15 6 -15 6 -6 15 -6 -15 -15 -6 15 -6 z" fill="#fffaf2"/>
</svg>
